# ==============================================================================
# SOFT DEW — SUPABASE CONFIGURATION
# ==============================================================================
# 1. Sign up or log into https://supabase.com
# 2. Create a new project named "Soft-Dew"
# 3. Go to Project Settings -> API
# 4. Copy "Project URL" and paste as VITE_SUPABASE_URL
# 5. Copy "anon public" API Key and paste as VITE_SUPABASE_ANON_KEY
# 6. Run the script in `supabase_schema.sql` inside the Supabase SQL Editor.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

